{
  "name": "@synalla/memory",
  "version": "0.0.1",
  "private": true,
  "description": "Owned, local, encrypted memory for the agents you already run (MCP).",
  "license": "AGPL-3.0-only OR LicenseRef-Synalla-Commercial",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "synalla-memory": "bin/synalla-memory.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --import ./tools/ts-resolve.mjs --test --test-timeout=120000 --test-force-exit \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
