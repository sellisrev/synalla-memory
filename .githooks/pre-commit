#!/bin/sh
# Gate: strict typecheck, then the full protocol test suite (with the golden walk) must pass before any commit.
cd "$(git rev-parse --show-toplevel)" || exit 1
npx tsc -p tsconfig.json >/tmp/synalla-precommit.log 2>&1 || { tail -30 /tmp/synalla-precommit.log; echo "pre-commit: typecheck failed"; exit 1; }
npm test --silent >/tmp/synalla-precommit.log 2>&1 || { tail -30 /tmp/synalla-precommit.log; echo "pre-commit: synalla tests failed"; exit 1; }
grep -qE "^ℹ skipped [1-9]" /tmp/synalla-precommit.log && { echo "pre-commit: skipped tests are not allowed"; exit 1; }
exit 0
